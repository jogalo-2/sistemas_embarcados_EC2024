const int led = 12;
const int potPin = A2;

void setup()
{
    pinMode(led, OUTPUT);

    // Inicia comunicação com o Monitor Serial
    Serial.begin(9600);
}

void loop()
{
    int valorPot = analogRead(potPin);

    // Mostra o valor do potenciômetro
    Serial.print("Valor do potenciometro: ");
    Serial.println(valorPot);

    // ligado
    digitalWrite(led, HIGH);
    delay(valorPot);

    // desligado
    digitalWrite(led, LOW);
    delay(valorPot);
}
