// Leds
const int terceiro = 10;
const int segundo = 9;
const int primeiro = 8;

void setup()
{
  pinMode(primeiro, OUTPUT);
  pinMode(segundo, OUTPUT);
  pinMode(terceiro, OUTPUT);

}

void loop()
{
  // ESTADO 1 = numero 0
  digitalWrite(primeiro, LOW);
  digitalWrite(segundo, LOW);
  digitalWrite(terceiro, LOW);
  
  delay(5000);

    // ESTADO 2 = numero 1
  digitalWrite(primeiro, HIGH);
  digitalWrite(segundo, LOW);
  digitalWrite(terceiro, LOW);
  
  delay(5000);

    // ESTADO 3 = numero 2
  digitalWrite(primeiro, LOW);
  digitalWrite(segundo, HIGH);
  digitalWrite(terceiro, LOW);
  
  delay(5000);

    // ESTADO 4 = numero 3
  digitalWrite(primeiro, HIGH);
  digitalWrite(segundo, HIGH);
  digitalWrite(terceiro, LOW);
  
  delay(5000);

    // ESTADO 5 = numero 4
  digitalWrite(primeiro, LOW);
  digitalWrite(segundo, LOW);
  digitalWrite(terceiro, HIGH);
  
  delay(5000);

    // ESTADO 6 = numero 5
  digitalWrite(primeiro, HIGH);
  digitalWrite(segundo, LOW);
  digitalWrite(terceiro, HIGH);
  
  delay(5000);

    // ESTADO 7 = numero 6
  digitalWrite(primeiro, LOW);
  digitalWrite(segundo, HIGH);
  digitalWrite(terceiro, HIGH);
  
  delay(5000);

    // ESTADO 8 = numero 7
  digitalWrite(primeiro, HIGH);
  digitalWrite(segundo, HIGH);
  digitalWrite(terceiro, HIGH);
  
  delay(5000);
  for(int i = 0; i < 5; i++){
  digitalWrite(primeiro, HIGH);
  digitalWrite(segundo, LOW);
  digitalWrite(terceiro, LOW);
	delay(150);
	
  digitalWrite(primeiro, LOW);
  digitalWrite(segundo, HIGH);
  digitalWrite(terceiro, LOW);
  delay(150);
  
  digitalWrite(primeiro, LOW);
  digitalWrite(segundo, LOW);
  digitalWrite(terceiro, HIGH);
  delay(150);
  
  }
  delay(2000);
}
